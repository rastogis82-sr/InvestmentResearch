# Investment Research Assistant -- Gradio frontend config
#
# Copy this file to `.env` in the same directory as gradio_app.py for
# local/Vocareum testing. On Render (or any other host), set these as
# real environment variables in the dashboard instead -- never commit a
# real .env, and this one is excluded by .gitignore on purpose.

# Required: the deployed FastAPI service's base URL, no trailing slash.
API_BASE_URL=https://investment-research-api-xxxx.onrender.com

# Optional -- defaults shown.
API_TIMEOUT_SECONDS=60
GRADIO_SHARE=false
