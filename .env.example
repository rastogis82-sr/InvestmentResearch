# Copy this file to `.env` and fill in real values for LOCAL testing only
# (running investment_research_api.py on your own machine or in Vocareum).
#
# NEVER commit the real `.env` file to git — it's excluded in .gitignore
# on purpose. On Render, don't use this file at all: set each of these as
# a real environment variable in the service's Environment tab instead
# (render.yaml already declares which ones Render should ask you for).
#
# investment_research_api.py reads every one of these from the process
# environment via os.environ.get(...) — nothing below is ever hardcoded
# in the application code.

# --- LLM configuration ---
MOCK_LLM=false
LLM_PROVIDER=openai:gpt-4o-mini
OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here        # only if LLM_PROVIDER starts with "anthropic:"
# OPENAI_BASE_URL=https://openai.vocareum.com/v1    # optional — Vocareum-issued proxy key instead of a personal OpenAI key

# --- RAG configuration ---
IRA_SCORE_THRESHOLD=0.35
IRA_CORPUS_DIR=/tmp/investment_research_kb

# --- Real-company market data (Twelve Data) — optional ---
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
TWELVEDATA_CACHE_TTL_SECONDS=30

# --- Real-company market data (Yahoo Finance, via the `yfinance` package)
# — optional, but recommended alongside Twelve Data: covers company
# profile and real financial-statement data (revenue, margins) that
# Twelve Data's free plan can't provide at all. See merged_market_data.py.
# No API key, no signup, no published rate limit -- but also no official
# support or SLA, since it's an unofficial interface to Yahoo's own
# internal endpoints (see yahoo_finance_market_data.py's module
# docstring). Nothing to set here beyond the optional cache TTL. ---
YAHOO_FINANCE_CACHE_TTL_SECONDS=30
